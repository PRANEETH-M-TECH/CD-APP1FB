    {
      "scene_no": 4,
      "purpose": "Calculate the probability of getting all tails when tossing 4 coins.",
      "visual_strategy": "math_derivation",
      "template_id": "math_derivation",
      "teacher_script": "If we want to find the probability of getting all tails, we multiply the probability of getting a tail for each coin. This means 1/2 multiplied four times, resulting in 1/16.",
      "visual_steps": [
        {
          "step_no": 1,
          "visual_type": "equation",
          "duration_seconds": 3.0,
          "content": {
            "text_content": "P(Tail on 1st coin) = \\frac{1}{2}"
          },
          "animation": {
            "transition": "fade",
            "camera_motion": "none"
          }
        },
        {
          "step_no": 2,
          "visual_type": "equation",
          "duration_seconds": 3.0,
          "content": {
            "text_content": "P(All Tails) = P(T) \\times P(T) \\times P(T) \\times P(T)"
          },
          "animation": {
            "transition": "fade",
            "camera_motion": "none"
          }
        },
        {
          "step_no": 3,
          "visual_type": "equation",
          "duration_seconds": 4.0,
          "content": {
            "text_content": "P(All Tails) = \\frac{1}{2} \\times \\frac{1}{2} \\times \\frac{1}{2} \\times \\frac{1}{2} = \\frac{1}{16}"
          },
          "animation": {
            "transition": "fade",
            "camera_motion": "zoom_in"
          }
        }
      ]
    },
