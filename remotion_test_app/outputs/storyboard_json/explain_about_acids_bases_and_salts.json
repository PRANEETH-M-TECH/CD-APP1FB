      "purpose": "Illustrate the neutralization reaction between acids and bases.",
      "visual_strategy": "process",
      "template_id": "math_derivation",
      "teacher_script": "When an acid and a base react, they undergo a neutralization reaction, producing a salt and water. This reaction balances out their acidic and basic properties.",
      "visual_steps": [
        {
          "step_no": 1,
          "visual_type": "equation",
          "duration_seconds": 3,
          "content": {
            "text_content": "\\text{Acid} + \\text{Base} \\rightarrow \\text{Salt} + \\text{Water}"
          },
          "animation": {
            "transition": "slide",
            "camera_motion": "none"
          }
        },
        {
          "step_no": 2,
          "visual_type": "equation",
          "duration_seconds": 4,
          "content": {
            "text_content": "\\text{HCl (Hydrochloric Acid)} + \\text{NaOH (Sodium Hydroxide)} \\rightarrow \\text{NaCl (Sodium Chloride)} + \\text{H}_2\\text{O (Water)}"
          },
          "animation": {
            "transition": "slide",
            "camera_motion": "none"
          }
        }
      ]
    },
