    {
      "scene_no": 6,
      "purpose": "Demonstrate solving a simple quadratic equation by factoring.",
      "visual_strategy": "process",
      "template_id": "math_derivation",
      "teacher_script": "Let's solve the equation x² - 5x + 6 = 0 by factoring. We need to find two numbers that multiply to 6 and add up to -5.",
      "visual_steps": [
        {
          "step_no": 1,
          "visual_type": "equation",
          "focus": null,
          "duration_seconds": 3,
          "content": {
            "text_content": "$x^2 - 5x + 6 = 0$"
          },
          "animation": {
            "transition": "fade",
            "camera_motion": "none"
          }
        },
        {
          "step_no": 2,
          "visual_type": "equation",
          "focus": null,
          "duration_seconds": 4,
          "content": {
            "text_content": "$(x - 2)(x - 3) = 0$"
          },
          "animation": {
            "transition": "slide",
            "camera_motion": "none"
          }
        },
        {
          "step_no": 3,
          "visual_type": "equation",
          "focus": null,
          "duration_seconds": 4,
          "content": {
            "text_content": "$x - 2 = 0 \\quad \\text{or} \\quad x - 3 = 0$"
          },
          "animation": {
            "transition": "slide",
            "camera_motion": "none"
          }
        },
        {
          "step_no": 4,
          "visual_type": "equation",
          "focus": null,
          "duration_seconds": 4,
          "content": {
            "text_content": "$x = 2 \\quad \\text{or} \\quad x = 3$"
          },
          "animation": {
            "transition": "slide",
            "camera_motion": "none"
          }
        }
      ],
