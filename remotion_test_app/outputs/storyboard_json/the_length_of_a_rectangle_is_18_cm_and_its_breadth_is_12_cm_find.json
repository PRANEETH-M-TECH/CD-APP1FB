    {
      "scene_no": 3,
      "purpose": "Calculate the perimeter of the rectangle.",
      "visual_strategy": "process",
      "template_id": "math_derivation",
      "teacher_script": "The perimeter is the total distance around the boundary of the rectangle. We can find it by adding up all four sides, or by using the formula: 2 times (length + breadth).",
      "visual_steps": [
        {
          "step_no": 1,
          "visual_type": "equation",
          "focus": "formula",
          "duration_seconds": 3,
          "content": {
            "text_content": "P = 2 \\times (L + B)"
          },
          "animation": {
            "transition": "fade",
            "camera_motion": "none"
          }
        },
        {
          "step_no": 2,
          "visual_type": "equation",
          "focus": "substitution",
          "duration_seconds": 3,
          "content": {
            "text_content": "P = 2 \\times (18 \\text{ cm} + 12 \\text{ cm})"
          },
          "animation": {
            "transition": "slide",
            "camera_motion": "none"
          }
        },
        {
          "step_no": 3,
          "visual_type": "equation",
          "focus": "sum",
          "duration_seconds": 3,
          "content": {
            "text_content": "P = 2 \\times (30 \\text{ cm})"
          },
          "animation": {
            "transition": "slide",
            "camera_motion": "none"
          }
        },
        {
          "step_no": 4,
          "visual_type": "equation",
          "focus": "result",
          "duration_seconds": 3,
          "content": {
            "text_content": "P = 60 \\text{ cm}"
          },
          "animation": {
            "transition": "slide",
            "camera_motion": "none"
          }
        }
      ]
    },
    {
      "scene_no": 4,
      "purpose": "Calculate the area of the rectangle.",
      "visual_strategy": "process",
      "template_id": "math_derivation",
      "teacher_script": "The area is the amount of surface covered by the rectangle. We calculate it by simply multiplying its length by its breadth.",
      "visual_steps": [
        {
          "step_no": 1,
          "visual_type": "equation",
          "focus": "formula",
          "duration_seconds": 3,
          "content": {
            "text_content": "A = L \\times B"
          },
          "animation": {
            "transition": "fade",
            "camera_motion": "none"
          }
        },
        {
          "step_no": 2,
          "visual_type": "equation",
          "focus": "substitution",
          "duration_seconds": 3,
          "content": {
            "text_content": "A = 18 \\text{ cm} \\times 12 \\text{ cm}"
          },
          "animation": {
            "transition": "slide",
            "camera_motion": "none"
          }
        },
        {
          "step_no": 3,
          "visual_type": "equation",
          "focus": "result",
          "duration_seconds": 3,
          "content": {
            "text_content": "A = 216 \\text{ cm}^2"
          },
          "animation": {
            "transition": "slide",
            "camera_motion": "none"
          }
        }
      ]
