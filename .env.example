# ── Database & Vector Store Configuration ─────────────────────────────────────
# Qdrant URL (e.g. Local: http://localhost:6333 or Qdrant Cloud URL)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=textbooks_v2

# Supabase database config
# IMPORTANT: if left unset, the code falls back to a hardcoded production
# Supabase project - always set these explicitly for local/dev work so you
# don't accidentally read or write shared production data.
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Redis (optional - used for caching). If unreachable, the app automatically
# falls back to an in-memory cache (data lost on restart) instead of failing.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Google Cloud Storage bucket name for books
GCS_BUCKET_NAME=chaduvuguru-books

# ── Firebase (optional here) ───────────────────────────────────────────────────
# Firestore is normally configured via a serviceAccountKey.json file at the
# repo root instead (see README.md) - only set ONE of these if a file isn't
# convenient (e.g. some cloud deployments), pasting the full key JSON as a
# single-line string.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_CREDENTIALS={"type":"service_account",...}

# ── AI API Keys ─────────────────────────────────────────────────────────────
# OpenAI API configuration (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Text-To-Speech (TTS) Configuration ───────────────────────────────────────
# Sarvam AI Bulbul v3 (Get key at: https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# Microsoft Azure TTS
AZURE_TTS_API_KEY=your_azure_api_key_here
AZURE_TTS_REGION=your_azure_region_here

# HuggingFace Token (For AI4Bharat IndicTTS)
HUGGINGFACE_TOKEN=your_huggingface_token_here
