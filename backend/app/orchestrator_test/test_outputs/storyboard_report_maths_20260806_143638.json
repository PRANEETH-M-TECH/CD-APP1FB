      "scene_no": 3,
      "purpose": "Demonstrate the process of completing the square to derive the quadratic formula.",
      "beat_shape": "process_spatial",
      "template_id": "illustrated_scene",
      "template_selection_reasoning": "The math derivation template is ideal for showing step-by-step calculations, making it easier for students to follow the derivation process.",
      "camera": {
        "zoom": 1.1,
        "pan_x": 0,
        "pan_y": 0,
        "target_node": "main_concept"
      },
      "teacher_script": "To derive the quadratic formula, we start with ax² + bx + c = 0. Let's complete the square step by step.",
      "template_data": {
        "title": "Derivation Steps",
        "formula": "ax² + bx + c = 0",
        "steps": [
          "Divide the equation by a: x² + (b/a)x + (c/a) = 0",
          "Rearrange: x² + (b/a)x = - (c/a)",
          "Complete the square: (x + b/2a)² = (b² - 4ac)/4a²",
          "Take square root: x + b/2a = ±√(b² - 4ac)/2a",
          "Solve for x: x = -b ± √(b² - 4ac) / 2a"
        ]
      }
    },
